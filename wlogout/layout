        "action": "systemctl poweroff",
        "text": "Shutdown",
        "keybind": "s"
    },
    {
        "label": "reboot",
        "action": "systemctl reboot",
        "text": "Reboot",
        "keybind": "r"
    },
    {
        "label": "logout",
        "action": "loginctl terminate-user $USER",
        "text": "Logout",
        "keybind": "l"
    },
    {
        "label": "lock",
        "action": "swaylock",
        "text": "Lock",
        "keybind": "k"
    },
    {
        "label": "suspend",
        "action": "systemctl suspend",
        "text": "Suspend",
        "keybind": "u"
    }
