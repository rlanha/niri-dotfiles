* {
    bg: #002B36;
    bg-alt: #073642;
    bg-hover: #0a4a5a;
    fg: #BCC3C3;
    fg-muted: #93A1A1;
    accent: #ffb52a;
    border-color: #094557;

    spacing: 6px;
}

window {
    background-color: @bg;
    border: 1px;
    border-color: @border-color;
    border-radius: 8px;
    padding: 10px;
}

prompt {
    background-color: @accent;
    color: @bg;
    padding: 2px 8px;
    margin: 4px;
}

inputbar {
    background-color: @bg-alt;
    padding: 6px 10px;
    margin-bottom: 8px;
}

entry {
    background-color: transparent;
    color: @fg;
    font-weight: bold;
}

listview {
    background-color: transparent;
}

element {
    background-color: transparent;
    color: @fg;
    padding: 8px 10px;
    border: 0px;
    border-radius: 4px;
}

element selected {
    background-color: @bg-hover;
    color: @fg;
}

element-icon {
    size: 24px;
    margin-right: 10px;
}

element-text {
    color: @fg;
}

scrollbar {
    handle-width: 4px;
    handle-color: @accent;
}
